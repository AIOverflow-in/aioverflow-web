# Contact form (Resend)
# Sign up at https://resend.com, create an API key, and add a verified domain.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Where contact form submissions are forwarded to (defaults to company.email)
CONTACT_TO_EMAIL=aioverflow.ml@gmail.com

# Verified Resend "from" address (e.g. "AI Overflow <hello@aioverflow.com>")
# Until you verify a domain you can use Resend's sandbox: "AI Overflow <onboarding@resend.dev>"
CONTACT_FROM_EMAIL="AI Overflow <onboarding@resend.dev>"
